# Server-side configuration. Never use NEXT_PUBLIC_ for API keys.
AI_PROVIDER=sarvam
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_MODEL=sarvam-105b
# Alternative provider (select AI_PROVIDER=openai to use it):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Real AI by default; offline rules remain explicitly selectable in the UI.
RESOLVE_AGENT_MODE=deterministic
# Credit-safe by default. Enable deliberately only for a live AI demo.
AI_LIVE_ENABLED=false
AI_ONE_SHOT=false

# Login: local development only. Use HTTPS + true for deployment.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Paytm MCP: no connection is made until explicitly enabled and invoked.
PAYTM_MCP_ENABLED=false
PAYTM_MCP_URL=https://mcp.paytmpayments.com/mcp
PAYTM_MCP_ACCESS_TOKEN=
PAYTM_MERCHANT_ID=

# Local offline guest workspace. Keep false for real integrations.
AUTH_DEMO_MODE=false

# Explicit single-use Sarvam demo for the local guest workspace; off by default.
AI_DEMO_ENABLED=false
